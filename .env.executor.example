# Salin jadi .env.executor di PC eksekutor. JANGAN di-commit (sudah di .gitignore).
# Login MT5 HFM (akun DEMO dulu). Nama server lihat di MT5: menu akun, contoh HFMarketsGlobal-Demo
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Opsional: path terminal64.exe kalau ada lebih dari satu MT5 terpasang
# MT5_PATH=C:\Program Files\HFM MetaTrader 5\terminal64.exe

# Risiko per trade (% ekuitas) untuk Grade A; Grade B = RISK_PCT × RISK_PCT_B_FACTOR
RISK_PCT=1.0
RISK_PCT_B_FACTOR=0.5
# Maksimal setup aktif (pending + posisi) bersamaan
MAX_OPEN_SETUPS=3
# Rugi harian (realized) ≥ % saldo ini → berhenti pasang order sampai besok UTC
DAILY_LOSS_PCT=3.0
# 50% lot TP1 + 50% lot TP2 (false = satu order TP1)
SPLIT_TP=true
# Kalau simbol broker pakai suffix (mis. EURUSD.z) atau nama beda (emas = GOLD)
MT5_SYMBOL_SUFFIX=
# MT5_SYMBOL_MAP={"XAU/USD": "GOLD"}
POLL_SEC=20
# Kirim laporan order ke Telegram (pakai TELEGRAM_BOT_TOKEN/CHAT_ID dari .env)
EXECUTOR_TELEGRAM=true

# Antrean order (sama dengan .env scanner)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
