# Twelve Data — https://twelvedata.com → Dashboard → API Keys
TWELVEDATA_API_KEY=

# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=
# Default claude-sonnet-5 (lebih murah & baru dari sonnet-4-6). Ganti kalau mau.
CLAUDE_MODEL=claude-sonnet-5
# GRADER=rule → skip Claude, pakai rule grade (buat test lokal tanpa API key)
# GRADER=

# Telegram (Fase 0)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-1004442245236

# chart-img.com (opsional) — chart TradingView asli; kosong = pakai matplotlib
CHART_IMG_API_KEY=
# ID layout TradingView yang di-share (dari URL tradingview.com/chart/<ID>/)
CHART_IMG_LAYOUT_ID=

# Upstash Redis — https://upstash.com → Create Database → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Runtime
# Tahap sinyal harmonic yang dikirim: approaching (SIAPKAN ORDER: pasang limit),
# in_prz (MASUK ZONA), left (jangan kejar). Contoh cuma zona: SIGNAL_STAGES=in_prz
SIGNAL_STAGES=approaching,in_prz,left
# R:R minimum ke TP2 (harmonic) / R:R efektif (POC)
MIN_RR_TP2=2.0
# SIGNAL_VERBOSE=true → pesan panjang (struktur, rasio, reasoning) selain ringkas
SIGNAL_VERBOSE=false
LOG_LEVEL=info
DRY_RUN=true
# POC pullback screener (strategi kedua) ikut jalan di setiap scan; false = matikan
POC_ENABLED=true
